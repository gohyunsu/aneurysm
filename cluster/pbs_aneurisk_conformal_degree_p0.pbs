#!/usr/bin/env bash
#PBS -N aurora_degree_p0
#PBS -q coss_agpu
#PBS -l select=1:ncpus=4:mem=16gb:ngpus=0
#PBS -l walltime=02:00:00
#PBS -j oe

set -euo pipefail
umask 077

: "${PBS_JOBID:?this audit must run inside a PBS allocation}"
: "${AURORA_PROJECT_ROOT:?set the exact clean public checkout}"
: "${AURORA_GIT_COMMIT:?set the exact public SHA}"
: "${AURORA_OUTPUT_ROOT:?set a private writable aggregate root}"
: "${AURORA_CONTAINER:?set the pinned readable Python container}"

if [[ ! "$AURORA_GIT_COMMIT" =~ ^[0-9a-f]{40}$ ]]; then
  echo "AURORA_GIT_COMMIT must be a full lowercase SHA." >&2
  exit 90
fi
if [[ "$(git -C "$AURORA_PROJECT_ROOT" rev-parse HEAD)" != "$AURORA_GIT_COMMIT" ]]; then
  echo "source commit mismatch" >&2
  exit 90
fi
if [[ -n "$(git -C "$AURORA_PROJECT_ROOT" status --porcelain)" ]]; then
  echo "source checkout must be clean" >&2
  exit 91
fi
if [[ ! -r "$AURORA_CONTAINER" ]]; then
  echo "pinned container is not readable" >&2
  exit 92
fi
if ! command -v singularity >/dev/null 2>&1; then
  echo "singularity is unavailable" >&2
  exit 92
fi

record_root="$AURORA_OUTPUT_ROOT/aneurisk_conformal_degree_p0/records"
status_path="$record_root/status.$PBS_JOBID.json"
result_path="$record_root/result.$PBS_JOBID.private.json"
job_tmp="${TMPDIR:-/tmp}/aurora_aneurisk_degree_$PBS_JOBID"
container_result="$job_tmp/result.private.json"
mkdir -p "$record_root" "$job_tmp/payload"

shopt -s nullglob
for prior_status in "$record_root"/status.*.json; do
  if grep -Fq '"protocol_id":"aneurisk_conformal_degree_archive_semantics_p0_v1"' "$prior_status" \
      && grep -Fq "\"public_source_commit\":\"$AURORA_GIT_COMMIT\"" "$prior_status"; then
    echo "An exact-source P0 record exists; resubmission is forbidden." >&2
    exit 93
  fi
done
shopt -u nullglob

write_status() {
  local state="$1"
  local exit_code="$2"
  local gate_evaluated="$3"
  local temporary="$status_path.partial"
  printf '{"protocol_id":"aneurisk_conformal_degree_archive_semantics_p0_v1","state":"%s","exit_code":%s,"public_source_commit":"%s","scientific_gate_evaluated":%s,"critical_point_extraction":false,"conformal_calibration":false,"method":false,"gpu":false,"outer_test":false}\n' \
    "$state" "$exit_code" "$AURORA_GIT_COMMIT" "$gate_evaluated" > "$temporary"
  mv "$temporary" "$status_path"
}

write_status running 0 false
audit_complete=false
on_exit() {
  local exit_code=$?
  trap - EXIT
  if [[ "$audit_complete" != true ]]; then
    write_status execution_incomplete "$exit_code" false
  fi
  exit "$exit_code"
}
trap on_exit EXIT

singularity exec --cleanenv \
  --pwd /workspace \
  --bind "$AURORA_PROJECT_ROOT:/workspace:ro" \
  --bind "$job_tmp:/run" \
  "$AURORA_CONTAINER" \
  env PYTHONDONTWRITEBYTECODE=1 PYTHONHASHSEED=0 PYTHONPATH=/workspace/src TMPDIR=/run/payload \
  python -m unittest -v tests.test_aneurisk_conformal_degree_p0

set +e
singularity exec --cleanenv \
  --pwd /workspace \
  --bind "$AURORA_PROJECT_ROOT:/workspace:ro" \
  --bind "$job_tmp:/run" \
  "$AURORA_CONTAINER" \
  env PYTHONDONTWRITEBYTECODE=1 PYTHONHASHSEED=0 PYTHONPATH=/workspace/src TMPDIR=/run/payload \
  python -m aurora.aneurisk_conformal_degree_p0 \
    --config /workspace/configs/aneurisk_conformal_degree_p0.json \
    --work-dir /run/payload \
    --result /run/result.private.json \
    --public-source-commit "$AURORA_GIT_COMMIT"
audit_exit=$?
set -e

if [[ ! -s "$container_result" ]]; then
  exit "$audit_exit"
fi
cp "$container_result" "$result_path.partial"
mv "$result_path.partial" "$result_path"

read -r result_status gate_evaluated < <(
  singularity exec --cleanenv \
    --pwd /workspace \
    --bind "$job_tmp:/run:ro" \
    "$AURORA_CONTAINER" \
    python - /run/result.private.json <<'PY'
import json
with open("/run/result.private.json", encoding="utf-8") as stream:
    result = json.load(stream)
print(result.get("status", "invalid"), str(bool(result.get("scientific_gate_evaluated"))).lower())
PY
)

case "$result_status" in
  passed_asset_semantics_gate)
    write_status completed_pass 0 true
    ;;
  failed_asset_semantics_gate)
    write_status completed_fail "$audit_exit" true
    ;;
  execution_incomplete_no_scientific_verdict)
    write_status execution_incomplete "$audit_exit" false
    ;;
  *)
    exit 94
    ;;
esac

audit_complete=true
exit "$audit_exit"
