#!/bin/bash
#PBS -N aurora_aneug_v4_d5
#PBS -q coss_agpu
#PBS -l select=1:ncpus=4:mem=64gb:ngpus=0
#PBS -l walltime=02:00:00
#PBS -j oe

set -euo pipefail

: "${AURORA_PROJECT_ROOT:?set exact clean public checkout}"
: "${AURORA_DATA_ROOT:?set private AneuG data root}"
: "${AURORA_OUTPUT_ROOT:?set private output parent}"
: "${AURORA_PYTHON:?set pinned Python executable}"
: "${AURORA_EXPECTED_COMMIT:?set Quality-passed exact commit}"

actual_commit="$(git -C "$AURORA_PROJECT_ROOT" rev-parse HEAD)"
[ "$actual_commit" = "$AURORA_EXPECTED_COMMIT" ]
[ -z "$(git -C "$AURORA_PROJECT_ROOT" status --porcelain)" ]
[ -x "$AURORA_PYTHON" ]

record_root="$AURORA_OUTPUT_ROOT/aneug_processed_v4_d5_v1"
transient="$AURORA_DATA_ROOT/processed_v4_d3/assembled_registered_data_1k_v4.pth"
mkdir -p "$record_root"

if [ -e "$record_root/attempt.started" ]; then
  echo "D5 attempt already exists; rerun is forbidden" >&2
  exit 90
fi
printf '%s\n' "${PBS_JOBID:-unknown}" > "$record_root/attempt.started"
attempt_log="$record_root/attempt.log"
attempt_status="$record_root/attempt.status.json"
gate_pass_json=null
exec >>"$attempt_log" 2>&1
trap 'code=$?; trap - EXIT; printf "{\"exit_code\":%s,\"complete\":%s,\"gate_pass\":%s,\"scientific_verdict\":null}\n" "$code" "$(test -e "$record_root/attempt.complete" && printf true || printf false)" "$gate_pass_json" > "$attempt_status"; exit "$code"' EXIT
printf 'stage=wrapper_started job=%s commit=%s\n' "${PBS_JOBID:-unknown}" "$actual_commit"

PYTHONPATH="$AURORA_PROJECT_ROOT/src" "$AURORA_PYTHON" \
  -m aurora.aneug_processed_v4_d5_v1 \
  --config "$AURORA_PROJECT_ROOT/configs/aneug_processed_v4_d5_v1.json" \
  --transient "$transient" \
  --public-result "$record_root/public_ghd_component_result.json" \
  --private-grouping-manifest "$record_root/private_ghd_component_manifest.json"

gate_pass_json="$("$AURORA_PYTHON" -c 'import json,sys; print(str(json.load(open(sys.argv[1], encoding="utf-8"))["gate_pass"]).lower())' "$record_root/public_ghd_component_result.json")"
printf '%s\n' complete > "$record_root/attempt.complete"
printf 'stage=ghd_component_audit_complete gate_pass=%s\n' "$gate_pass_json"
