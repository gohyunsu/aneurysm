#!/bin/bash
#PBS -N aurora_d13c_functional
#PBS -q coss_a6gpu
#PBS -l select=1:ncpus=4:mem=64gb:ngpus=1:Qlist=a6000
#PBS -l walltime=06:00:00

record_root="${PBS_O_WORKDIR:-.}"
/bin/mkdir -p "$record_root" || exit 70
if [ -e "$record_root/attempt.started" ]; then
  printf '%s\n' "This run ID already has an attempt record; choose a new run ID." >&2
  exit 90
fi
printf '%s\n' "${PBS_JOBID:-missing}" > "$record_root/attempt.started" || exit 71
exec >>"$record_root/attempt.log" 2>&1

attempt_status="$record_root/attempt.status.json"
status_tmp="$record_root/attempt.status.json.tmp"
run_complete_json=false

set -euo pipefail
trap 'code=$?; trap - EXIT; printf "{\"exit_code\":%s,\"complete\":%s,\"run_complete\":%s}\n" "$code" "$(test -e "$record_root/attempt.complete" && printf true || printf false)" "$run_complete_json" > "$status_tmp"; /bin/mv -f "$status_tmp" "$attempt_status"; exit "$code"' EXIT

: "${AURORA_PROJECT_ROOT:?set exact clean public checkout}"
: "${AURORA_EXPECTED_COMMIT:?set exact Quality-passed commit}"
: "${AURORA_D13C_ACTIVATION:?set fresh private D13C activation}"
: "${AURORA_D13C_VARIANT:?set one activated D13C variant}"
: "${AURORA_D9_CACHE:?set completed private D9 cache}"
: "${AURORA_D11_CHECKPOINT:?set exact private D11 checkpoint}"
: "${AURORA_CONTAINER:?set pinned container}"
: "${AURORA_CONTAINER_SHA256:?set pinned container SHA-256}"

case "$AURORA_D13C_VARIANT" in
  field_only|statistics_scalarized|osi_scalarized|all_scalarized|all_field_anchored) ;;
  *) printf '%s\n' "Invalid D13C variant." >&2; exit 72 ;;
esac

actual_commit="$(/usr/bin/git -C "$AURORA_PROJECT_ROOT" rev-parse HEAD)"
[ "$actual_commit" = "$AURORA_EXPECTED_COMMIT" ]
[ -z "$(/usr/bin/git -C "$AURORA_PROJECT_ROOT" status --porcelain)" ]
[ "$(/usr/bin/sha256sum "$AURORA_CONTAINER" | /usr/bin/cut -d' ' -f1)" = "$AURORA_CONTAINER_SHA256" ]
[ -f "$AURORA_D9_CACHE/cache_manifest.json" ]
[ -r "$AURORA_D13C_ACTIVATION" ]
[ -r "$AURORA_D11_CHECKPOINT" ]

activation_parent="$(/usr/bin/dirname "$AURORA_D13C_ACTIVATION")"
activation_name="$(/usr/bin/basename "$AURORA_D13C_ACTIVATION")"
checkpoint_parent="$(/usr/bin/dirname "$AURORA_D11_CHECKPOINT")"
checkpoint_name="$(/usr/bin/basename "$AURORA_D11_CHECKPOINT")"

printf 'stage=D13C_functional_finetune_started variant=%s job=%s commit=%s\n' "$AURORA_D13C_VARIANT" "${PBS_JOBID:-missing}" "$actual_commit"
/usr/bin/singularity exec --nv --cleanenv \
  --bind "$AURORA_PROJECT_ROOT:/workspace:ro" \
  --bind "$activation_parent:/private/activation:ro" \
  --bind "$checkpoint_parent:/private/d11:ro" \
  --bind "$AURORA_D9_CACHE:/cache:ro" \
  --bind "$record_root:/output" \
  "$AURORA_CONTAINER" \
  /usr/bin/env PYTHONDONTWRITEBYTECODE=1 OMP_NUM_THREADS=4 MKL_NUM_THREADS=4 CUBLAS_WORKSPACE_CONFIG=:4096:8 PYTHONPATH=/workspace/src \
  python -m aurora.aneug_processed_v4_d13c_functional_finetune \
  --config /workspace/configs/aneug_processed_v4_d13c_functional_finetune_v1.json \
  --activation "/private/activation/$activation_name" \
  --expected-commit "$AURORA_EXPECTED_COMMIT" \
  --cache /cache \
  --d11-checkpoint "/private/d11/$checkpoint_name" \
  --variant "$AURORA_D13C_VARIANT" \
  --result "/output/d13c_${AURORA_D13C_VARIANT}_result.json" \
  --checkpoint "/output/d13c_${AURORA_D13C_VARIANT}_best.pt"

run_complete_json=true
printf '%s\n' complete > "$record_root/attempt.complete"
printf 'stage=D13C_functional_finetune_complete variant=%s\n' "$AURORA_D13C_VARIANT"
