#!/bin/bash
#PBS -N aurora_730_ghd_func
#PBS -q coss_a6gpu
#PBS -l select=1:ncpus=4:mem=64gb:ngpus=1:Qlist=a6000
#PBS -l walltime=24:00:00
#PBS -j oe

set -euo pipefail

: "${AURORA_PROJECT_ROOT:?set exact clean public checkout}"
: "${AURORA_DATA_ROOT:?set private AneuG data root}"
: "${AURORA_OUTPUT_ROOT:?set private output root}"
: "${AURORA_EXPECTED_COMMIT:?set Quality-passed exact commit}"
: "${AURORA_EXECUTION_SERVER:?set introai9 or junjinyong}"
: "${AURORA_GHD_FUNCTIONAL_ACTIVATION:?set fresh one-objective activation}"
: "${AURORA_GHD_FUNCTIONAL_OBJECTIVE:?set field_only, all_scalarized or all_field_anchored}"
: "${AURORA_GHD_INITIAL_CHECKPOINT:?set exact terminal GHD-GPS best checkpoint}"
: "${AURORA_GHD_RESULT:?set exact terminal GHD-GPS result}"
: "${AURORA_GHD_TERMINAL_STATUS:?set exact terminal GHD-GPS status}"
: "${AURORA_PRIVATE_SPLIT_MANIFEST:?set exact private R3 split manifest}"
: "${AURORA_PRIVATE_TRAIN_AUDIT:?set exact private train-only audit}"
: "${AURORA_CONTAINER:?set pinned Torch container}"
: "${AURORA_CONTAINER_SHA256:?set pinned container SHA-256}"

case "$AURORA_EXECUTION_SERVER" in
  introai9|junjinyong) ;;
  *) exit 64 ;;
esac
case "$AURORA_GHD_FUNCTIONAL_OBJECTIVE" in
  field_only|all_scalarized|all_field_anchored) ;;
  *) exit 64 ;;
esac

actual_commit="$(git -C "$AURORA_PROJECT_ROOT" rev-parse HEAD)"
[ "$actual_commit" = "$AURORA_EXPECTED_COMMIT" ]
[ -z "$(git -C "$AURORA_PROJECT_ROOT" status --porcelain)" ]
for evidence in \
  "$AURORA_GHD_FUNCTIONAL_ACTIVATION" \
  "$AURORA_GHD_INITIAL_CHECKPOINT" \
  "$AURORA_GHD_RESULT" \
  "$AURORA_GHD_TERMINAL_STATUS" \
  "$AURORA_PRIVATE_SPLIT_MANIFEST" \
  "$AURORA_PRIVATE_TRAIN_AUDIT"
do
  [ -r "$evidence" ]
done
[ "$(/usr/bin/sha256sum "$AURORA_PRIVATE_SPLIT_MANIFEST" | /usr/bin/cut -d' ' -f1)" = "4ff881055c45ee87c917fbfe1a7ed5102ef63b9426539aea647eea7b65e3077f" ]
[ "$(/usr/bin/sha256sum "$AURORA_PRIVATE_TRAIN_AUDIT" | /usr/bin/cut -d' ' -f1)" = "ce1dd6d2852e290fbe187ac062af155f522cd4b8a82c1580b5430d15ed519385" ]
[ "$(/usr/bin/sha256sum "$AURORA_CONTAINER" | /usr/bin/cut -d' ' -f1)" = "$AURORA_CONTAINER_SHA256" ]

run_id="${PBS_JOBID:-manual_$(date -u +%Y%m%dT%H%M%SZ)}"
run_root="$AURORA_OUTPUT_ROOT/aneug_release_730_ghd_functional_finetune_v1/$AURORA_GHD_FUNCTIONAL_OBJECTIVE/$run_id"
mkdir -p "$run_root"
[ ! -e "$run_root/attempt.started" ]
printf '%s\n' "$run_id" > "$run_root/attempt.started"
log="$run_root/attempt.log"
status="$run_root/attempt.status.json"
status_tmp="$run_root/attempt.status.json.tmp"
exec >>"$log" 2>&1
trap 'code=$?; trap - EXIT; printf "{\"job_id\":\"%s\",\"exit_code\":%s,\"complete\":%s}\n" "$run_id" "$code" "$(test -f "$run_root/result.json" && printf true || printf false)" > "$status_tmp"; /bin/mv "$status_tmp" "$status"; exit "$code"' EXIT

activation_parent="$(/usr/bin/dirname "$AURORA_GHD_FUNCTIONAL_ACTIVATION")"
activation_name="$(/usr/bin/basename "$AURORA_GHD_FUNCTIONAL_ACTIVATION")"
checkpoint_parent="$(/usr/bin/dirname "$AURORA_GHD_INITIAL_CHECKPOINT")"
checkpoint_name="$(/usr/bin/basename "$AURORA_GHD_INITIAL_CHECKPOINT")"
result_parent="$(/usr/bin/dirname "$AURORA_GHD_RESULT")"
result_name="$(/usr/bin/basename "$AURORA_GHD_RESULT")"
terminal_parent="$(/usr/bin/dirname "$AURORA_GHD_TERMINAL_STATUS")"
terminal_name="$(/usr/bin/basename "$AURORA_GHD_TERMINAL_STATUS")"
split_parent="$(/usr/bin/dirname "$AURORA_PRIVATE_SPLIT_MANIFEST")"
split_name="$(/usr/bin/basename "$AURORA_PRIVATE_SPLIT_MANIFEST")"
audit_parent="$(/usr/bin/dirname "$AURORA_PRIVATE_TRAIN_AUDIT")"
audit_name="$(/usr/bin/basename "$AURORA_PRIVATE_TRAIN_AUDIT")"

resume_bind_args=()
resume_cli_args=()
if [ -n "${AURORA_GHD_FUNCTIONAL_RESUME_CHECKPOINT:-}" ]; then
  [ -r "$AURORA_GHD_FUNCTIONAL_RESUME_CHECKPOINT" ]
  [ -r "${AURORA_GHD_FUNCTIONAL_PRIOR_TERMINAL:?set prior failed/interrupted terminal record}" ]
  resume_parent="$(/usr/bin/dirname "$AURORA_GHD_FUNCTIONAL_RESUME_CHECKPOINT")"
  resume_name="$(/usr/bin/basename "$AURORA_GHD_FUNCTIONAL_RESUME_CHECKPOINT")"
  prior_parent="$(/usr/bin/dirname "$AURORA_GHD_FUNCTIONAL_PRIOR_TERMINAL")"
  prior_name="$(/usr/bin/basename "$AURORA_GHD_FUNCTIONAL_PRIOR_TERMINAL")"
  resume_bind_args=(
    --bind "$resume_parent:/private/resume:ro"
    --bind "$prior_parent:/private/prior:ro"
  )
  resume_cli_args=(
    --resume-checkpoint "/private/resume/$resume_name"
    --prior-attempt-terminal-record "/private/prior/$prior_name"
  )
else
  [ -z "${AURORA_GHD_FUNCTIONAL_PRIOR_TERMINAL:-}" ]
fi

printf 'stage=release730_ghd_functional_started job=%s commit=%s server=%s objective=%s\n' \
  "$run_id" "$actual_commit" "$AURORA_EXECUTION_SERVER" "$AURORA_GHD_FUNCTIONAL_OBJECTIVE"
/usr/bin/singularity exec --nv --cleanenv \
  --bind "$AURORA_PROJECT_ROOT:/workspace:ro" \
  --bind "$AURORA_DATA_ROOT:/data:ro" \
  --bind "$activation_parent:/private/activation:ro" \
  --bind "$checkpoint_parent:/private/checkpoint:ro" \
  --bind "$result_parent:/private/ghd_result:ro" \
  --bind "$terminal_parent:/private/ghd_terminal:ro" \
  --bind "$split_parent:/private/split:ro" \
  --bind "$audit_parent:/private/audit:ro" \
  "${resume_bind_args[@]}" \
  --bind "$run_root:/output" \
  "$AURORA_CONTAINER" \
  /usr/bin/env PYTHONDONTWRITEBYTECODE=1 OMP_NUM_THREADS=4 MKL_NUM_THREADS=4 CUBLAS_WORKSPACE_CONFIG=:4096:8 PYTHONPATH=/workspace/src \
  python -m aurora.aneug_release_730_ghd_functional_finetune \
  --config /workspace/configs/aneug_release_730_ghd_functional_finetune_v1.json \
  --activation "/private/activation/$activation_name" \
  --expected-commit "$actual_commit" \
  --expected-execution-server "$AURORA_EXECUTION_SERVER" \
  --objective-variant "$AURORA_GHD_FUNCTIONAL_OBJECTIVE" \
  --initial-checkpoint "/private/checkpoint/$checkpoint_name" \
  --ghd-gps-result "/private/ghd_result/$result_name" \
  --ghd-gps-terminal-status "/private/ghd_terminal/$terminal_name" \
  --transient /data/processed_v5_9dd4180/assembled_registered_data_1k_v5.pth \
  --steady /data/processed_v4_d2/assembled_registered_steady_data_1k_v4.pth.temporary \
  --public-split /workspace/results/aneug_release_730_split_r3_20260818.json \
  --private-split "/private/split/$split_name" \
  --train-audit-public /workspace/results/aneug_release_730_train_audit_r2_20260818.json \
  --train-audit-private "/private/audit/$audit_name" \
  --result /output/result.json \
  --checkpoint-directory /output/checkpoints \
  "${resume_cli_args[@]}"
printf 'stage=release730_ghd_functional_complete\n'
