#!/usr/bin/env bash
#PBS -N aurora_contract_test
#PBS -q ssu_a6gpu
#PBS -l select=1:ncpus=2:mem=16gb:ngpus=1:Qlist=a6000
#PBS -l walltime=00:20:00
#PBS -j oe

set -euo pipefail

: "${AURORA_PROJECT_ROOT:?set AURORA_PROJECT_ROOT}"
: "${AURORA_OUTPUT_ROOT:?set AURORA_OUTPUT_ROOT}"
: "${AURORA_SIF:?set AURORA_SIF}"
: "${AURORA_GIT_COMMIT:?set AURORA_GIT_COMMIT}"

mkdir -p "$AURORA_OUTPUT_ROOT/tmp"
cd "$PBS_O_WORKDIR"

hostname
nvidia-smi

bind_arguments=()
experiment_pythonpath="/workspace/src"
if [ -n "${AURORA_EXPERIMENT_DEPS:-}" ]; then
  bind_arguments+=(--bind "$AURORA_EXPERIMENT_DEPS:/experiment-deps:ro")
  experiment_pythonpath="/workspace/src:/experiment-deps"
fi

set +e
singularity exec --nv --cleanenv \
  --bind "$AURORA_PROJECT_ROOT:/workspace:ro" \
  --bind "$AURORA_OUTPUT_ROOT:/output" \
  "${bind_arguments[@]}" \
  "$AURORA_SIF" \
  env PYTHONPATH="$experiment_pythonpath" TMPDIR="/output/tmp" \
  python -m unittest discover -s /workspace/tests -v \
  > "$AURORA_OUTPUT_ROOT/tests.log" 2>&1
test_status=$?
set -e

printf '%s\n' "$AURORA_GIT_COMMIT" > "$AURORA_OUTPUT_ROOT/git_commit.txt"
if [ "$test_status" -eq 0 ]; then
  printf '%s\n' '{"state":"tests_completed","exit_status":0}' \
    > "$AURORA_OUTPUT_ROOT/status.json"
else
  printf '{"state":"tests_failed","exit_status":%s}\n' "$test_status" \
    > "$AURORA_OUTPUT_ROOT/status.json"
fi
exit "$test_status"
