#!/bin/bash
#PBS -N aurora_aneug_d9_r0
#PBS -q coss_agpu
#PBS -l select=1:ncpus=4:mem=64gb:ngpus=1
#PBS -l walltime=04:00:00

record_root="${PBS_O_WORKDIR:-.}"
/bin/mkdir -p "$record_root" || exit 70
if [ -e "$record_root/attempt.started" ]; then
  printf '%s\n' "D9 R0 attempt already exists; rerun or repair is forbidden" >&2
  exit 90
fi
printf '%s\n' "${PBS_JOBID:-missing}" > "$record_root/attempt.started" || exit 71
exec >>"$record_root/attempt.log" 2>&1

attempt_status="$record_root/attempt.status.json"
status_tmp="$record_root/attempt.status.json.tmp"
r0_pass_json=null

set -euo pipefail
trap 'code=$?; trap - EXIT; printf "{\"exit_code\":%s,\"complete\":%s,\"r0_pass\":%s,\"stage_closed\":true}\n" "$code" "$(test -e "$record_root/attempt.complete" && printf true || printf false)" "$r0_pass_json" > "$status_tmp"; /bin/mv -f "$status_tmp" "$attempt_status"; exit "$code"' EXIT

: "${AURORA_PROJECT_ROOT:?set exact clean public checkout}"
: "${AURORA_DATA_ROOT:?set private AneuG data root}"
: "${AURORA_PYTHON:?set approved Python executable}"
: "${AURORA_EXPECTED_COMMIT:?set Quality-passed exact commit}"
: "${AURORA_D5_PRIVATE_MANIFEST:?set exact private D5 manifest}"
: "${AURORA_D9_ACTIVATION:?set private D9 activation manifest}"
: "${AURORA_D9_CACHE:?set new private D9 cache path}"

actual_commit="$(/usr/bin/git -C "$AURORA_PROJECT_ROOT" rev-parse HEAD)"
[ "$actual_commit" = "$AURORA_EXPECTED_COMMIT" ]
[ -z "$(/usr/bin/git -C "$AURORA_PROJECT_ROOT" status --porcelain)" ]
[ -x "$AURORA_PYTHON" ]
[ ! -e "$AURORA_D9_CACHE" ]

config="$AURORA_PROJECT_ROOT/configs/aneug_processed_v4_d9_mesh_canonicalized_pilot_v1.json"
registration="$AURORA_PROJECT_ROOT/configs/aneug_processed_v4_d6_train_field_audit_v1.json"
transient="$AURORA_DATA_ROOT/processed_v4_d3/assembled_registered_data_1k_v4.pth"
steady="$AURORA_DATA_ROOT/processed_v4_d2/assembled_registered_steady_data_1k_v4.pth.temporary"

printf 'stage=R0_prepare_smoke_started job=%s commit=%s\n' "${PBS_JOBID:-missing}" "$actual_commit"
export OMP_NUM_THREADS=4
export MKL_NUM_THREADS=4
PYTHONPATH="$AURORA_PROJECT_ROOT/src" "$AURORA_PYTHON" \
  -m aurora.aneug_processed_v4_d9 \
  --config "$config" \
  --mode prepare \
  --activation "$AURORA_D9_ACTIVATION" \
  --expected-commit "$AURORA_EXPECTED_COMMIT" \
  --d6-registration "$registration" \
  --transient "$transient" \
  --steady "$steady" \
  --private-d5-manifest "$AURORA_D5_PRIVATE_MANIFEST" \
  --cache "$AURORA_D9_CACHE" \
  --result "$record_root/r0_result.json"

r0_pass_json="$("$AURORA_PYTHON" -c 'import json,sys; print(str(json.load(open(sys.argv[1], encoding="utf-8"))["r0_pass"]).lower())' "$record_root/r0_result.json")"
[ "$r0_pass_json" = true ]
printf '%s\n' complete > "$record_root/attempt.complete"
printf 'stage=R0_prepare_smoke_complete r0_pass=%s\n' "$r0_pass_json"
