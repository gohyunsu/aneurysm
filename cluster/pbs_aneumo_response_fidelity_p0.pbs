#!/usr/bin/env bash
#PBS -N aurora_response_fidelity_p0
#PBS -q coss_agpu
#PBS -l select=1:ncpus=4:mem=16gb:ngpus=0
#PBS -l walltime=01:00:00
#PBS -j oe

set -euo pipefail
umask 077

: "${PBS_JOBID:?this audit must run inside a PBS allocation}"
: "${AURORA_PROJECT_ROOT:?set the exact clean public checkout}"
: "${AURORA_GIT_COMMIT:?set the exact public SHA}"
: "${AURORA_OUTPUT_ROOT:?set a private writable aggregate root}"
: "${AURORA_CONTAINER:?set the pinned readable Python container}"
: "${AURORA_CACHE_PATH:?set the exact frozen private compact-cache path}"
: "${AURORA_CACHE_SHA256:?set the preflight-verified compact-cache SHA-256}"
: "${AURORA_EXTERNAL_SERVICE_CHANGE_ACK:?must name the prospective external-state record}"

if [[ ! "$AURORA_GIT_COMMIT" =~ ^[0-9a-f]{40}$ ]]; then
  echo "AURORA_GIT_COMMIT must be a full lowercase SHA." >&2
  exit 90
fi
if [[ ! "$AURORA_CACHE_SHA256" =~ ^[0-9a-f]{64}$ ]]; then
  echo "AURORA_CACHE_SHA256 must be a full lowercase SHA-256." >&2
  exit 90
fi
if [[ "$AURORA_EXTERNAL_SERVICE_CHANGE_ACK" != external_service_change_verified ]]; then
  echo "No verified external service change; P0 remains non-executable." >&2
  exit 91
fi
if [[ "$(git -C "$AURORA_PROJECT_ROOT" rev-parse HEAD)" != "$AURORA_GIT_COMMIT" ]]; then
  echo "source commit mismatch" >&2
  exit 92
fi
if [[ -n "$(git -C "$AURORA_PROJECT_ROOT" status --porcelain)" ]]; then
  echo "source checkout must be clean" >&2
  exit 92
fi
if [[ ! -r "$AURORA_CONTAINER" || ! -r "$AURORA_CACHE_PATH" ]]; then
  echo "container or exact cache is not readable" >&2
  exit 93
fi
if ! command -v singularity >/dev/null 2>&1; then
  echo "singularity is unavailable" >&2
  exit 93
fi

record_root="$AURORA_OUTPUT_ROOT/aneumo_response_fidelity_p0/records"
status_path="$record_root/status.$PBS_JOBID.json"
result_path="$record_root/result.$PBS_JOBID.private.json"
job_tmp="${TMPDIR:-/tmp}/aurora_response_fidelity_$PBS_JOBID"
container_result="$job_tmp/result.private.json"
mkdir -p "$record_root" "$job_tmp"

shopt -s nullglob
for prior_status in "$record_root"/status.*.json; do
  if grep -Fq '"protocol_id":"aneumo_response_fidelity_method_free_p0_v2"' "$prior_status" \
      && grep -Fq "\"public_source_commit\":\"$AURORA_GIT_COMMIT\"" "$prior_status"; then
    echo "An exact-source P0 record exists; resubmission is forbidden." >&2
    exit 94
  fi
done
shopt -u nullglob

write_status() {
  local state="$1"
  local exit_code="$2"
  local gate_evaluated="$3"
  local temporary="$status_path.partial"
  printf '{"protocol_id":"aneumo_response_fidelity_method_free_p0_v2","state":"%s","exit_code":%s,"public_source_commit":"%s","scientific_gate_evaluated":%s,"pressure":false,"validation_test":false,"method":false,"gpu":false,"outer_test":false,"paper_claim":false}\n' \
    "$state" "$exit_code" "$AURORA_GIT_COMMIT" "$gate_evaluated" > "$temporary"
  mv "$temporary" "$status_path"
}

write_status running 0 false
audit_complete=false
on_exit() {
  local exit_code=$?
  trap - EXIT
  if [[ "$audit_complete" != true ]]; then
    write_status execution_incomplete "$exit_code" false
  fi
  exit "$exit_code"
}
trap on_exit EXIT

set +e
singularity exec --cleanenv \
  --pwd /workspace \
  --bind "$AURORA_PROJECT_ROOT:/workspace:ro" \
  --bind "$AURORA_CACHE_PATH:$AURORA_CACHE_PATH:ro" \
  --bind "$job_tmp:/run" \
  "$AURORA_CONTAINER" \
  env PYTHONDONTWRITEBYTECODE=1 PYTHONHASHSEED=0 PYTHONPATH=/workspace/src TMPDIR=/run \
  python -m aurora.aneumo_response_fidelity_p0 \
    --config /workspace/configs/aneumo_response_fidelity_p0_v2.json \
    --root /workspace \
    --cache "$AURORA_CACHE_PATH" \
    --reported-cache-sha256 "$AURORA_CACHE_SHA256" \
    --output /run/result.private.json
audit_exit=$?
set -e

if [[ ! -s "$container_result" ]]; then
  exit "$audit_exit"
fi
cp "$container_result" "$result_path.partial"
mv "$result_path.partial" "$result_path"

read -r result_status gate_evaluated < <(
  singularity exec --cleanenv --bind "$job_tmp:/run:ro" "$AURORA_CONTAINER" \
    python - /run/result.private.json <<'PY'
import json
with open("/run/result.private.json", encoding="utf-8") as stream:
    result = json.load(stream)
print(result.get("status", "invalid"), str(bool(result.get("scientific_gate_evaluated"))).lower())
PY
)

case "$result_status" in
  passed_endpoint_stability_gate)
    write_status completed_pass 0 true
    ;;
  failed_endpoint_stability_gate)
    write_status completed_fail "$audit_exit" true
    ;;
  *)
    exit 95
    ;;
esac

audit_complete=true
exit "$audit_exit"
