#!/bin/bash
#PBS -N aurora_aneug_v4_d7v1
#PBS -q coss_agpu
#PBS -l select=1:ncpus=4:mem=64gb:ngpus=0
#PBS -l walltime=03:00:00

record_root="${PBS_O_WORKDIR:-.}"
/bin/mkdir -p "$record_root" || exit 70
if [ -e "$record_root/attempt.started" ]; then
  printf '%s\n' "D7 v1 attempt already exists; rerun or repair is forbidden" >&2
  exit 90
fi
printf '%s\n' "${PBS_JOBID:-missing}" > "$record_root/attempt.started" || exit 71
exec >>"$record_root/attempt.log" 2>&1

attempt_status="$record_root/attempt.status.json"
status_tmp="$record_root/attempt.status.json.tmp"
gate_pass_json=null
scientific_verdict_json=null

set -euo pipefail
trap 'code=$?; trap - EXIT; printf "{\"exit_code\":%s,\"complete\":%s,\"gate_pass\":%s,\"scientific_verdict\":%s,\"d7_closed\":true}\n" "$code" "$(test -e "$record_root/attempt.complete" && printf true || printf false)" "$gate_pass_json" "$scientific_verdict_json" > "$status_tmp"; /bin/mv -f "$status_tmp" "$attempt_status"; exit "$code"' EXIT

: "${AURORA_PROJECT_ROOT:?set exact clean public checkout}"
: "${AURORA_DATA_ROOT:?set private AneuG data root}"
: "${AURORA_PYTHON:?set approved Python executable}"
: "${AURORA_EXPECTED_COMMIT:?set Quality-passed exact commit}"
: "${AURORA_D5_PRIVATE_MANIFEST:?set exact private D5 manifest}"

actual_commit="$(/usr/bin/git -C "$AURORA_PROJECT_ROOT" rev-parse HEAD)"
[ "$actual_commit" = "$AURORA_EXPECTED_COMMIT" ]
[ -z "$(/usr/bin/git -C "$AURORA_PROJECT_ROOT" status --porcelain)" ]
[ -x "$AURORA_PYTHON" ]

execution="$AURORA_PROJECT_ROOT/configs/aneug_processed_v4_d7_execution_v1.json"
draft="$AURORA_PROJECT_ROOT/configs/aneug_processed_v4_d7_train_field_admission_draft_v1.json"
registration="$AURORA_PROJECT_ROOT/configs/aneug_processed_v4_d6_train_field_audit_v1.json"
evaluator="$AURORA_PROJECT_ROOT/src/aurora/aneug_processed_v4_d6.py"
transient="$AURORA_DATA_ROOT/processed_v4_d3/assembled_registered_data_1k_v4.pth"
steady="$AURORA_DATA_ROOT/processed_v4_d2/assembled_registered_steady_data_1k_v4.pth.temporary"

printf 'stage=wrapper_started job=%s commit=%s\n' "${PBS_JOBID:-missing}" "$actual_commit"
export OMP_NUM_THREADS=4
export MKL_NUM_THREADS=4
PYTHONPATH="$AURORA_PROJECT_ROOT/src" "$AURORA_PYTHON" \
  -m aurora.aneug_processed_v4_d7_execution \
  --execution-config "$execution" \
  --dormant-draft "$draft" \
  --registration "$registration" \
  --evaluator "$evaluator" \
  --transient "$transient" \
  --steady "$steady" \
  --private-d5-manifest "$AURORA_D5_PRIVATE_MANIFEST" \
  --public-result "$record_root/public_train_field_admission.json" \
  --private-statistics "$record_root/private_train_statistics.json"

gate_pass_json="$("$AURORA_PYTHON" -c 'import json,sys; print(str(json.load(open(sys.argv[1], encoding="utf-8"))["gate_pass"]).lower())' "$record_root/public_train_field_admission.json")"
scientific_verdict_json="$("$AURORA_PYTHON" -c 'import json,sys; print(json.dumps(json.load(open(sys.argv[1], encoding="utf-8"))["scientific_verdict"]))' "$record_root/public_train_field_admission.json")"
printf '%s\n' complete > "$record_root/attempt.complete"
printf 'stage=train_field_admission_complete gate_pass=%s\n' "$gate_pass_json"
