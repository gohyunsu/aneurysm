#!/bin/bash
#PBS -N aurora_730_response_local
#PBS -q coss_a6gpu
#PBS -l select=1:ncpus=4:mem=64gb:ngpus=1:Qlist=a6000
#PBS -l walltime=72:00:00
#PBS -j oe

set -euo pipefail

: "${AURORA_PROJECT_ROOT:?set exact clean public checkout}"
: "${AURORA_DATA_ROOT:?set private AneuG data root}"
: "${AURORA_OUTPUT_ROOT:?set private output root}"
: "${AURORA_EXPECTED_COMMIT:?set Quality-passed exact commit}"
: "${AURORA_RESPONSE_LOCAL_ACTIVATION:?set fresh private activation}"
: "${AURORA_RESPONSE_LOCAL_MODE:?set architecture or functional_finetune}"
: "${AURORA_RESPONSE_LOCAL_ARCHITECTURE:?set activated architecture variant}"
: "${AURORA_RESPONSE_LOCAL_OBJECTIVE:?set activated objective variant}"
: "${AURORA_RESPONSE_BASIS:?set exact train-only response basis artifact}"
: "${AURORA_RESPONSE_ORACLE_TERMINAL_RECORD:?set preserved oracle terminal record}"
: "${AURORA_GHD_GPS_TERMINAL_RECORD:?set preserved GHD-GPS terminal record}"
: "${AURORA_TRANSOLVER_TERMINAL_RECORD:?set preserved Transolver terminal record}"
: "${AURORA_PRIVATE_SPLIT_MANIFEST:?set exact private R3 split manifest}"
: "${AURORA_PRIVATE_TRAIN_AUDIT:?set exact private train-audit R2 statistics}"
: "${AURORA_CONTAINER:?set pinned Torch container}"
: "${AURORA_CONTAINER_SHA256:?set pinned container SHA-256}"

case "$AURORA_RESPONSE_LOCAL_MODE" in
  architecture)
    [ "$AURORA_RESPONSE_LOCAL_OBJECTIVE" = "field_only" ]
    case "$AURORA_RESPONSE_LOCAL_ARCHITECTURE" in
      response_only|response_plus_residual) ;;
      *) exit 64 ;;
    esac
    [ -z "${AURORA_RESPONSE_LOCAL_INITIAL_CHECKPOINT:-}" ]
    ;;
  functional_finetune)
    [ "$AURORA_RESPONSE_LOCAL_ARCHITECTURE" = "response_plus_residual" ]
    case "$AURORA_RESPONSE_LOCAL_OBJECTIVE" in
      field_only|all_scalarized|all_field_anchored) ;;
      *) exit 64 ;;
    esac
    [ -r "${AURORA_RESPONSE_LOCAL_INITIAL_CHECKPOINT:?set exact combined field-only checkpoint}" ]
    ;;
  *) exit 64 ;;
esac

actual_commit="$(git -C "$AURORA_PROJECT_ROOT" rev-parse HEAD)"
[ "$actual_commit" = "$AURORA_EXPECTED_COMMIT" ]
[ -z "$(git -C "$AURORA_PROJECT_ROOT" status --porcelain)" ]
for evidence in \
  "$AURORA_RESPONSE_LOCAL_ACTIVATION" \
  "$AURORA_RESPONSE_BASIS" \
  "$AURORA_RESPONSE_ORACLE_TERMINAL_RECORD" \
  "$AURORA_GHD_GPS_TERMINAL_RECORD" \
  "$AURORA_TRANSOLVER_TERMINAL_RECORD" \
  "$AURORA_PRIVATE_SPLIT_MANIFEST" \
  "$AURORA_PRIVATE_TRAIN_AUDIT"
do
  [ -r "$evidence" ]
done
[ "$(/usr/bin/sha256sum "$AURORA_PRIVATE_SPLIT_MANIFEST" | /usr/bin/cut -d' ' -f1)" = "4ff881055c45ee87c917fbfe1a7ed5102ef63b9426539aea647eea7b65e3077f" ]
[ "$(/usr/bin/sha256sum "$AURORA_PRIVATE_TRAIN_AUDIT" | /usr/bin/cut -d' ' -f1)" = "ce1dd6d2852e290fbe187ac062af155f522cd4b8a82c1580b5430d15ed519385" ]
[ "$(/usr/bin/sha256sum "$AURORA_CONTAINER" | /usr/bin/cut -d' ' -f1)" = "$AURORA_CONTAINER_SHA256" ]

run_id="${PBS_JOBID:-manual_$(date -u +%Y%m%dT%H%M%SZ)}"
run_root="$AURORA_OUTPUT_ROOT/aneug_release_730_response_local_candidate_v1/$run_id"
mkdir -p "$run_root"
[ ! -e "$run_root/attempt.started" ]
printf '%s\n' "$run_id" > "$run_root/attempt.started"
log="$run_root/attempt.log"
status="$run_root/attempt.status.json"
status_tmp="$run_root/attempt.status.json.tmp"
exec >>"$log" 2>&1
trap 'code=$?; trap - EXIT; printf "{\"job_id\":\"%s\",\"exit_code\":%s,\"complete\":%s}\n" "$run_id" "$code" "$(test -f "$run_root/result.json" && printf true || printf false)" > "$status_tmp"; /bin/mv "$status_tmp" "$status"; exit "$code"' EXIT

activation_parent="$(/usr/bin/dirname "$AURORA_RESPONSE_LOCAL_ACTIVATION")"
activation_name="$(/usr/bin/basename "$AURORA_RESPONSE_LOCAL_ACTIVATION")"
basis_parent="$(/usr/bin/dirname "$AURORA_RESPONSE_BASIS")"
basis_name="$(/usr/bin/basename "$AURORA_RESPONSE_BASIS")"
oracle_terminal_parent="$(/usr/bin/dirname "$AURORA_RESPONSE_ORACLE_TERMINAL_RECORD")"
oracle_terminal_name="$(/usr/bin/basename "$AURORA_RESPONSE_ORACLE_TERMINAL_RECORD")"
ghd_terminal_parent="$(/usr/bin/dirname "$AURORA_GHD_GPS_TERMINAL_RECORD")"
ghd_terminal_name="$(/usr/bin/basename "$AURORA_GHD_GPS_TERMINAL_RECORD")"
transolver_terminal_parent="$(/usr/bin/dirname "$AURORA_TRANSOLVER_TERMINAL_RECORD")"
transolver_terminal_name="$(/usr/bin/basename "$AURORA_TRANSOLVER_TERMINAL_RECORD")"
split_parent="$(/usr/bin/dirname "$AURORA_PRIVATE_SPLIT_MANIFEST")"
split_name="$(/usr/bin/basename "$AURORA_PRIVATE_SPLIT_MANIFEST")"
audit_parent="$(/usr/bin/dirname "$AURORA_PRIVATE_TRAIN_AUDIT")"
audit_name="$(/usr/bin/basename "$AURORA_PRIVATE_TRAIN_AUDIT")"

initial_bind_args=()
initial_cli_args=()
if [ "$AURORA_RESPONSE_LOCAL_MODE" = "functional_finetune" ]; then
  initial_parent="$(/usr/bin/dirname "$AURORA_RESPONSE_LOCAL_INITIAL_CHECKPOINT")"
  initial_name="$(/usr/bin/basename "$AURORA_RESPONSE_LOCAL_INITIAL_CHECKPOINT")"
  initial_bind_args=(--bind "$initial_parent:/private/initial:ro")
  initial_cli_args=(--initial-combined-field-checkpoint "/private/initial/$initial_name")
fi

resume_bind_args=()
resume_cli_args=()
if [ -n "${AURORA_RESPONSE_LOCAL_RESUME_CHECKPOINT:-}" ]; then
  [ -r "$AURORA_RESPONSE_LOCAL_RESUME_CHECKPOINT" ]
  [ -r "${AURORA_RESPONSE_LOCAL_PRIOR_ATTEMPT_TERMINAL_RECORD:?set prior failed/interrupted attempt terminal record}" ]
  resume_parent="$(/usr/bin/dirname "$AURORA_RESPONSE_LOCAL_RESUME_CHECKPOINT")"
  resume_name="$(/usr/bin/basename "$AURORA_RESPONSE_LOCAL_RESUME_CHECKPOINT")"
  prior_terminal_parent="$(/usr/bin/dirname "$AURORA_RESPONSE_LOCAL_PRIOR_ATTEMPT_TERMINAL_RECORD")"
  prior_terminal_name="$(/usr/bin/basename "$AURORA_RESPONSE_LOCAL_PRIOR_ATTEMPT_TERMINAL_RECORD")"
  resume_bind_args=(
    --bind "$resume_parent:/private/resume:ro"
    --bind "$prior_terminal_parent:/private/prior_terminal:ro"
  )
  resume_cli_args=(
    --resume-checkpoint "/private/resume/$resume_name"
    --prior-attempt-terminal-record "/private/prior_terminal/$prior_terminal_name"
  )
else
  [ -z "${AURORA_RESPONSE_LOCAL_PRIOR_ATTEMPT_TERMINAL_RECORD:-}" ]
fi

printf 'stage=release730_response_local_started job=%s commit=%s mode=%s architecture=%s objective=%s\n' \
  "$run_id" "$actual_commit" "$AURORA_RESPONSE_LOCAL_MODE" \
  "$AURORA_RESPONSE_LOCAL_ARCHITECTURE" "$AURORA_RESPONSE_LOCAL_OBJECTIVE"
/usr/bin/singularity exec --nv --cleanenv \
  --bind "$AURORA_PROJECT_ROOT:/workspace:ro" \
  --bind "$AURORA_DATA_ROOT:/data:ro" \
  --bind "$activation_parent:/private/activation:ro" \
  --bind "$basis_parent:/private/basis:ro" \
  --bind "$oracle_terminal_parent:/private/oracle_terminal:ro" \
  --bind "$ghd_terminal_parent:/private/ghd_terminal:ro" \
  --bind "$transolver_terminal_parent:/private/transolver_terminal:ro" \
  --bind "$split_parent:/private/split:ro" \
  --bind "$audit_parent:/private/audit:ro" \
  "${initial_bind_args[@]}" \
  "${resume_bind_args[@]}" \
  --bind "$run_root:/output" \
  "$AURORA_CONTAINER" \
  /usr/bin/env PYTHONDONTWRITEBYTECODE=1 OMP_NUM_THREADS=4 MKL_NUM_THREADS=4 CUBLAS_WORKSPACE_CONFIG=:4096:8 PYTHONPATH=/workspace/src \
  python -m aurora.aneug_release_730_response_local_candidate \
  --config /workspace/configs/aneug_release_730_response_local_candidate_v1.json \
  --activation "/private/activation/$activation_name" \
  --expected-commit "$actual_commit" \
  --mode "$AURORA_RESPONSE_LOCAL_MODE" \
  --architecture-variant "$AURORA_RESPONSE_LOCAL_ARCHITECTURE" \
  --objective-variant "$AURORA_RESPONSE_LOCAL_OBJECTIVE" \
  --response-basis "/private/basis/$basis_name" \
  --response-oracle-terminal-record "/private/oracle_terminal/$oracle_terminal_name" \
  --ghd-gps-terminal-record "/private/ghd_terminal/$ghd_terminal_name" \
  --transolver-terminal-record "/private/transolver_terminal/$transolver_terminal_name" \
  --transient /data/processed_v5_9dd4180/assembled_registered_data_1k_v5.pth \
  --steady /data/processed_v4_d2/assembled_registered_steady_data_1k_v4.pth.temporary \
  --public-split /workspace/results/aneug_release_730_split_r3_20260818.json \
  --private-split "/private/split/$split_name" \
  --train-audit-public /workspace/results/aneug_release_730_train_audit_r2_20260818.json \
  --train-audit-private "/private/audit/$audit_name" \
  --result /output/result.json \
  --checkpoint-directory /output/checkpoints \
  "${initial_cli_args[@]}" \
  "${resume_cli_args[@]}"
printf 'stage=release730_response_local_complete\n'
