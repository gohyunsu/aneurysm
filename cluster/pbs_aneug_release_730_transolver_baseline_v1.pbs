#!/bin/bash
#PBS -N aurora_730_transolver
#PBS -q coss_a6gpu
#PBS -l select=1:ncpus=4:mem=64gb:ngpus=1:Qlist=a6000
#PBS -l walltime=24:00:00
#PBS -j oe

set -euo pipefail

: "${AURORA_PROJECT_ROOT:?set exact clean public checkout}"
: "${AURORA_DATA_ROOT:?set private AneuG data root}"
: "${AURORA_OUTPUT_ROOT:?set private output root}"
: "${AURORA_EXPECTED_COMMIT:?set Quality-passed exact commit}"
: "${AURORA_TRANSOLVER_ACTIVATION:?set fresh private activation}"
: "${AURORA_RESPONSE_ORACLE_TERMINAL_RECORD:?set preserved response-oracle terminal record}"
: "${AURORA_GHD_GPS_TERMINAL_RECORD:?set preserved GHD-GPS terminal record}"
: "${AURORA_PRIVATE_SPLIT_MANIFEST:?set exact private R3 split manifest}"
: "${AURORA_PRIVATE_TRAIN_AUDIT:?set exact private train-audit R2 statistics}"
: "${AURORA_CONTAINER:?set pinned Torch container}"
: "${AURORA_CONTAINER_SHA256:?set pinned container SHA-256}"

actual_commit="$(git -C "$AURORA_PROJECT_ROOT" rev-parse HEAD)"
[ "$actual_commit" = "$AURORA_EXPECTED_COMMIT" ]
[ -z "$(git -C "$AURORA_PROJECT_ROOT" status --porcelain)" ]
[ -r "$AURORA_TRANSOLVER_ACTIVATION" ]
[ -r "$AURORA_RESPONSE_ORACLE_TERMINAL_RECORD" ]
[ -r "$AURORA_GHD_GPS_TERMINAL_RECORD" ]
[ -r "$AURORA_PRIVATE_SPLIT_MANIFEST" ]
[ -r "$AURORA_PRIVATE_TRAIN_AUDIT" ]
[ "$(/usr/bin/sha256sum "$AURORA_PRIVATE_SPLIT_MANIFEST" | /usr/bin/cut -d' ' -f1)" = "4ff881055c45ee87c917fbfe1a7ed5102ef63b9426539aea647eea7b65e3077f" ]
[ "$(/usr/bin/sha256sum "$AURORA_PRIVATE_TRAIN_AUDIT" | /usr/bin/cut -d' ' -f1)" = "ce1dd6d2852e290fbe187ac062af155f522cd4b8a82c1580b5430d15ed519385" ]
[ "$(/usr/bin/sha256sum "$AURORA_CONTAINER" | /usr/bin/cut -d' ' -f1)" = "$AURORA_CONTAINER_SHA256" ]

run_id="${PBS_JOBID:-manual_$(date -u +%Y%m%dT%H%M%SZ)}"
run_root="$AURORA_OUTPUT_ROOT/aneug_release_730_transolver_baseline_v1/$run_id"
mkdir -p "$run_root"
[ ! -e "$run_root/attempt.started" ]
printf '%s\n' "$run_id" > "$run_root/attempt.started"
log="$run_root/attempt.log"
status="$run_root/attempt.status.json"
status_tmp="$run_root/attempt.status.json.tmp"
exec >>"$log" 2>&1
trap 'code=$?; trap - EXIT; printf "{\"job_id\":\"%s\",\"exit_code\":%s,\"complete\":%s}\n" "$run_id" "$code" "$(test -f "$run_root/result.json" && printf true || printf false)" > "$status_tmp"; /bin/mv "$status_tmp" "$status"; exit "$code"' EXIT

activation_parent="$(/usr/bin/dirname "$AURORA_TRANSOLVER_ACTIVATION")"
activation_name="$(/usr/bin/basename "$AURORA_TRANSOLVER_ACTIVATION")"
oracle_terminal_parent="$(/usr/bin/dirname "$AURORA_RESPONSE_ORACLE_TERMINAL_RECORD")"
oracle_terminal_name="$(/usr/bin/basename "$AURORA_RESPONSE_ORACLE_TERMINAL_RECORD")"
ghd_terminal_parent="$(/usr/bin/dirname "$AURORA_GHD_GPS_TERMINAL_RECORD")"
ghd_terminal_name="$(/usr/bin/basename "$AURORA_GHD_GPS_TERMINAL_RECORD")"
split_parent="$(/usr/bin/dirname "$AURORA_PRIVATE_SPLIT_MANIFEST")"
split_name="$(/usr/bin/basename "$AURORA_PRIVATE_SPLIT_MANIFEST")"
audit_parent="$(/usr/bin/dirname "$AURORA_PRIVATE_TRAIN_AUDIT")"
audit_name="$(/usr/bin/basename "$AURORA_PRIVATE_TRAIN_AUDIT")"
printf 'stage=release730_transolver_started job=%s commit=%s\n' "$run_id" "$actual_commit"
/usr/bin/singularity exec --nv --cleanenv \
  --bind "$AURORA_PROJECT_ROOT:/workspace:ro" \
  --bind "$AURORA_DATA_ROOT:/data:ro" \
  --bind "$activation_parent:/private/activation:ro" \
  --bind "$oracle_terminal_parent:/private/oracle_terminal:ro" \
  --bind "$ghd_terminal_parent:/private/ghd_terminal:ro" \
  --bind "$split_parent:/private/split:ro" \
  --bind "$audit_parent:/private/audit:ro" \
  --bind "$run_root:/output" \
  "$AURORA_CONTAINER" \
  /usr/bin/env PYTHONDONTWRITEBYTECODE=1 OMP_NUM_THREADS=4 MKL_NUM_THREADS=4 CUBLAS_WORKSPACE_CONFIG=:4096:8 PYTHONPATH=/workspace/src \
  python -m aurora.aneug_release_730_transolver_baseline \
  --config /workspace/configs/aneug_release_730_transolver_baseline_v1.json \
  --activation "/private/activation/$activation_name" \
  --response-oracle-terminal-record "/private/oracle_terminal/$oracle_terminal_name" \
  --ghd-gps-terminal-record "/private/ghd_terminal/$ghd_terminal_name" \
  --expected-commit "$actual_commit" \
  --transient /data/processed_v5_9dd4180/assembled_registered_data_1k_v5.pth \
  --steady /data/processed_v4_d2/assembled_registered_steady_data_1k_v4.pth.temporary \
  --public-split /workspace/results/aneug_release_730_split_r3_20260818.json \
  --private-split "/private/split/$split_name" \
  --train-audit-public /workspace/results/aneug_release_730_train_audit_r2_20260818.json \
  --train-audit-private "/private/audit/$audit_name" \
  --result /output/result.json \
  --checkpoint-directory /output/checkpoints
printf 'stage=release730_transolver_complete\n'
