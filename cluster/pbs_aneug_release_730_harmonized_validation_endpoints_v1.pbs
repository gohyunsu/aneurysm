#!/bin/bash
#PBS -N aurora_730_harmonized_V
#PBS -q coss_agpu
#PBS -l select=1:ncpus=4:mem=64gb:ngpus=1:Qlist=agpu
#PBS -l walltime=06:00:00
#PBS -j oe

set -euo pipefail

: "${AURORA_PROJECT_ROOT:?set exact clean Quality-passed public checkout}"
: "${AURORA_DATA_ROOT:?set private AneuG data root}"
: "${AURORA_OUTPUT_ROOT:?set private output root}"
: "${AURORA_EXPECTED_COMMIT:?set exact public commit}"
: "${AURORA_HARMONIZED_VALIDATION_ACTIVATION:?set fresh private activation}"
: "${AURORA_GRAPH_RESULT:?set exact terminal Graph U-Net result}"
: "${AURORA_GRAPH_TERMINAL_RECORD:?set exact terminal Graph U-Net record}"
: "${AURORA_GRAPH_CHECKPOINT:?set exact frozen Graph U-Net checkpoint}"
: "${AURORA_GHD_GPS_RESULT:?set exact terminal GHD-GPS result}"
: "${AURORA_GHD_GPS_TERMINAL_RECORD:?set exact terminal GHD-GPS record}"
: "${AURORA_GHD_GPS_CHECKPOINT:?set exact frozen GHD-GPS checkpoint}"
: "${AURORA_TRANSOLVER_RESULT:?set exact terminal Transolver result}"
: "${AURORA_TRANSOLVER_TERMINAL_RECORD:?set exact terminal Transolver record}"
: "${AURORA_TRANSOLVER_CHECKPOINT:?set exact frozen Transolver checkpoint}"
: "${AURORA_PRIVATE_SPLIT_MANIFEST:?set exact private R3 split manifest}"
: "${AURORA_PRIVATE_TRAIN_AUDIT:?set exact private train-audit statistics}"
: "${AURORA_OFFICIAL_ROOT:?set exact clean official source checkout}"
: "${AURORA_PYG_TARGET:?set isolated PyG 2.6.1 target}"
: "${AURORA_CONTAINER:?set pinned Torch container}"
: "${AURORA_CONTAINER_SHA256:?set pinned container SHA-256}"

actual_commit="$(git -C "$AURORA_PROJECT_ROOT" rev-parse HEAD)"
[ "$actual_commit" = "$AURORA_EXPECTED_COMMIT" ]
[ -z "$(git -C "$AURORA_PROJECT_ROOT" status --porcelain)" ]
[ "$(git -C "$AURORA_OFFICIAL_ROOT" rev-parse HEAD)" = "4a090a0f12538deef6fcea88b81afe78ce38152e" ]
[ -z "$(git -C "$AURORA_OFFICIAL_ROOT" status --porcelain)" ]
for evidence in \
  "$AURORA_HARMONIZED_VALIDATION_ACTIVATION" \
  "$AURORA_GRAPH_RESULT" \
  "$AURORA_GRAPH_TERMINAL_RECORD" \
  "$AURORA_GRAPH_CHECKPOINT" \
  "$AURORA_GHD_GPS_RESULT" \
  "$AURORA_GHD_GPS_TERMINAL_RECORD" \
  "$AURORA_GHD_GPS_CHECKPOINT" \
  "$AURORA_TRANSOLVER_RESULT" \
  "$AURORA_TRANSOLVER_TERMINAL_RECORD" \
  "$AURORA_TRANSOLVER_CHECKPOINT" \
  "$AURORA_PRIVATE_SPLIT_MANIFEST" \
  "$AURORA_PRIVATE_TRAIN_AUDIT"
do
  [ -r "$evidence" ]
done
[ -d "$AURORA_PYG_TARGET" ]
[ "$(/usr/bin/sha256sum "$AURORA_PROJECT_ROOT/configs/aneug_release_730_harmonized_validation_endpoints_v1.json" | /usr/bin/cut -d' ' -f1)" = "b4fe3314e0b696aab6e02b4307afd2bf6e7013a38d526e6767da1e8788ba4cf8" ]
[ "$(/usr/bin/sha256sum "$AURORA_PROJECT_ROOT/src/aurora/aneug_release_730_harmonized_validation_endpoints.py" | /usr/bin/cut -d' ' -f1)" = "d6e48fff67b2249d0be77bdbabdb5218c5eb930d897fc3ee6f60b4434f2d91b7" ]
[ "$(/usr/bin/sha256sum "$AURORA_PROJECT_ROOT/tests/test_aneug_release_730_harmonized_validation_endpoints.py" | /usr/bin/cut -d' ' -f1)" = "1f573b0760dbc3ad93bb7c7708db1f4a7e23d1ee5a0a10a17b264bb8d529d17b" ]
[ "$(/usr/bin/sha256sum "$AURORA_PRIVATE_SPLIT_MANIFEST" | /usr/bin/cut -d' ' -f1)" = "4ff881055c45ee87c917fbfe1a7ed5102ef63b9426539aea647eea7b65e3077f" ]
[ "$(/usr/bin/sha256sum "$AURORA_PRIVATE_TRAIN_AUDIT" | /usr/bin/cut -d' ' -f1)" = "ce1dd6d2852e290fbe187ac062af155f522cd4b8a82c1580b5430d15ed519385" ]
[ "$(/usr/bin/sha256sum "$AURORA_CONTAINER" | /usr/bin/cut -d' ' -f1)" = "$AURORA_CONTAINER_SHA256" ]
[ "$AURORA_CONTAINER_SHA256" = "2da7b186ba8fc25efb1a5ffcbb5251974d11a57198a7c0970a61ae05b88681f2" ]

run_id="${PBS_JOBID:?harmonized validation evaluation is PBS-only}"
run_root="$AURORA_OUTPUT_ROOT/aneug_release_730_harmonized_validation_endpoints_v1/$run_id"
/bin/mkdir -p "$run_root"
[ ! -e "$run_root/attempt.started" ]
/usr/bin/printf '%s\n' "$run_id" > "$run_root/attempt.started"
log="$run_root/attempt.log"
status="$run_root/attempt.status.json"
status_tmp="$run_root/attempt.status.json.tmp"
exec >>"$log" 2>&1
trap 'code=$?; trap - EXIT; /usr/bin/printf "{\"job_id\":\"%s\",\"exit_code\":%s,\"complete\":%s}\n" "$run_id" "$code" "$(test -f "$run_root/result.json" && printf true || printf false)" > "$status_tmp"; /bin/mv "$status_tmp" "$status"; exit "$code"' EXIT

activation_parent="$(/usr/bin/dirname "$AURORA_HARMONIZED_VALIDATION_ACTIVATION")"
activation_name="$(/usr/bin/basename "$AURORA_HARMONIZED_VALIDATION_ACTIVATION")"
split_parent="$(/usr/bin/dirname "$AURORA_PRIVATE_SPLIT_MANIFEST")"
split_name="$(/usr/bin/basename "$AURORA_PRIVATE_SPLIT_MANIFEST")"
audit_parent="$(/usr/bin/dirname "$AURORA_PRIVATE_TRAIN_AUDIT")"
audit_name="$(/usr/bin/basename "$AURORA_PRIVATE_TRAIN_AUDIT")"

/usr/bin/printf 'stage=release730_harmonized_validation_started job=%s commit=%s\n' "$run_id" "$actual_commit"
/usr/bin/singularity exec --nv --cleanenv \
  --bind "$AURORA_PROJECT_ROOT:/workspace:ro" \
  --bind "$AURORA_DATA_ROOT:/data:ro" \
  --bind "$activation_parent:/private/activation:ro" \
  --bind "$(/usr/bin/dirname "$AURORA_GRAPH_RESULT"):/private/graph_result:ro" \
  --bind "$(/usr/bin/dirname "$AURORA_GRAPH_TERMINAL_RECORD"):/private/graph_terminal:ro" \
  --bind "$(/usr/bin/dirname "$AURORA_GRAPH_CHECKPOINT"):/private/graph_checkpoint:ro" \
  --bind "$(/usr/bin/dirname "$AURORA_GHD_GPS_RESULT"):/private/ghd_result:ro" \
  --bind "$(/usr/bin/dirname "$AURORA_GHD_GPS_TERMINAL_RECORD"):/private/ghd_terminal:ro" \
  --bind "$(/usr/bin/dirname "$AURORA_GHD_GPS_CHECKPOINT"):/private/ghd_checkpoint:ro" \
  --bind "$(/usr/bin/dirname "$AURORA_TRANSOLVER_RESULT"):/private/transolver_result:ro" \
  --bind "$(/usr/bin/dirname "$AURORA_TRANSOLVER_TERMINAL_RECORD"):/private/transolver_terminal:ro" \
  --bind "$(/usr/bin/dirname "$AURORA_TRANSOLVER_CHECKPOINT"):/private/transolver_checkpoint:ro" \
  --bind "$split_parent:/private/split:ro" \
  --bind "$audit_parent:/private/audit:ro" \
  --bind "$AURORA_OFFICIAL_ROOT:/official:ro" \
  --bind "$AURORA_PYG_TARGET:/pyg:ro" \
  --bind "$run_root:/output" \
  "$AURORA_CONTAINER" \
  /usr/bin/env PYTHONDONTWRITEBYTECODE=1 OMP_NUM_THREADS=4 MKL_NUM_THREADS=4 CUBLAS_WORKSPACE_CONFIG=:4096:8 PYTHONPATH=/pyg:/workspace/src:/official \
  python -m aurora.aneug_release_730_harmonized_validation_endpoints \
  --config /workspace/configs/aneug_release_730_harmonized_validation_endpoints_v1.json \
  --activation "/private/activation/$activation_name" \
  --expected-commit "$actual_commit" \
  --graph-config /workspace/configs/aneug_release_730_official_graphunet_baseline_v1.json \
  --ghd-gps-config /workspace/configs/aneug_release_730_ghd_gps_baseline_v1.json \
  --transolver-config /workspace/configs/aneug_release_730_transolver_baseline_v1.json \
  --released-graph-unet-adapter-result "/private/graph_result/$(/usr/bin/basename "$AURORA_GRAPH_RESULT")" \
  --released-graph-unet-adapter-terminal "/private/graph_terminal/$(/usr/bin/basename "$AURORA_GRAPH_TERMINAL_RECORD")" \
  --released-graph-unet-adapter-checkpoint "/private/graph_checkpoint/$(/usr/bin/basename "$AURORA_GRAPH_CHECKPOINT")" \
  --ghd-gps-unet-result "/private/ghd_result/$(/usr/bin/basename "$AURORA_GHD_GPS_RESULT")" \
  --ghd-gps-unet-terminal "/private/ghd_terminal/$(/usr/bin/basename "$AURORA_GHD_GPS_TERMINAL_RECORD")" \
  --ghd-gps-unet-checkpoint "/private/ghd_checkpoint/$(/usr/bin/basename "$AURORA_GHD_GPS_CHECKPOINT")" \
  --transolver-result "/private/transolver_result/$(/usr/bin/basename "$AURORA_TRANSOLVER_RESULT")" \
  --transolver-terminal "/private/transolver_terminal/$(/usr/bin/basename "$AURORA_TRANSOLVER_TERMINAL_RECORD")" \
  --transolver-checkpoint "/private/transolver_checkpoint/$(/usr/bin/basename "$AURORA_TRANSOLVER_CHECKPOINT")" \
  --transient /data/processed_v5_9dd4180/assembled_registered_data_1k_v5.pth \
  --steady /data/processed_v4_d2/assembled_registered_steady_data_1k_v4.pth.temporary \
  --public-split /workspace/results/aneug_release_730_split_r3_20260818.json \
  --private-split "/private/split/$split_name" \
  --train-audit-public /workspace/results/aneug_release_730_train_audit_r2_20260818.json \
  --train-audit-private "/private/audit/$audit_name" \
  --official-root /official \
  --output /output/result.json
/usr/bin/printf 'stage=release730_harmonized_validation_complete\n'
