#!/bin/bash
#PBS -N aurora_aneug_730_split
#PBS -q coss_agpu
#PBS -l select=1:ncpus=4:mem=64gb:ngpus=0
#PBS -l walltime=02:00:00
#PBS -j oe

set -euo pipefail

: "${AURORA_PROJECT_ROOT:?set exact clean public checkout}"
: "${AURORA_DATA_ROOT:?set private AneuG data root}"
: "${AURORA_OUTPUT_ROOT:?set private output root}"
: "${AURORA_EXPECTED_COMMIT:?set Quality-passed exact commit}"
: "${AURORA_SPLIT_KEY_FILE:?set private 32-byte hex split-key file}"
: "${AURORA_CONTAINER:?set pinned Torch container}"
: "${AURORA_CONTAINER_SHA256:?set pinned container SHA-256}"

actual_commit="$(git -C "$AURORA_PROJECT_ROOT" rev-parse HEAD)"
[ "$actual_commit" = "$AURORA_EXPECTED_COMMIT" ]
[ -z "$(git -C "$AURORA_PROJECT_ROOT" status --porcelain)" ]
[ -r "$AURORA_CONTAINER" ]
[ "$(/usr/bin/sha256sum "$AURORA_CONTAINER" | /usr/bin/cut -d' ' -f1)" = "$AURORA_CONTAINER_SHA256" ]

source_path="$AURORA_DATA_ROOT/processed_v5_9dd4180/assembled_registered_data_1k_v5.pth"
finalize_record="$AURORA_DATA_ROOT/processed_v5_9dd4180/finalize_116626.ECE-util1.tsv"
schema_record="$AURORA_DATA_ROOT/processed_v5_9dd4180/schema_116627.ECE-util1.json"
run_id="${PBS_JOBID:-manual_$(date -u +%Y%m%dT%H%M%SZ)}"
run_root="$AURORA_OUTPUT_ROOT/aneug_release_730_split_v1/$run_id"
mkdir -p "$run_root"
[ ! -e "$run_root/attempt.started" ]
printf '%s\n' "$run_id" > "$run_root/attempt.started"
log="$run_root/attempt.log"
status="$run_root/attempt.status.json"
exec >>"$log" 2>&1
trap 'code=$?; trap - EXIT; printf "{\"job_id\":\"%s\",\"exit_code\":%s,\"complete\":%s}\n" "$run_id" "$code" "$(test -f "$run_root/public_split_result.json" && printf true || printf false)" > "$status"; exit "$code"' EXIT

printf 'stage=split_started job=%s commit=%s\n' "$run_id" "$actual_commit"
split_key_parent="$(/usr/bin/dirname "$AURORA_SPLIT_KEY_FILE")"
split_key_name="$(/usr/bin/basename "$AURORA_SPLIT_KEY_FILE")"
/usr/bin/singularity exec --cleanenv \
  --bind "$AURORA_PROJECT_ROOT:/workspace:ro" \
  --bind "$AURORA_DATA_ROOT:/data:ro" \
  --bind "$split_key_parent:/private/key:ro" \
  --bind "$run_root:/output" \
  "$AURORA_CONTAINER" \
  /usr/bin/env PYTHONDONTWRITEBYTECODE=1 OMP_NUM_THREADS=4 MKL_NUM_THREADS=4 PYTHONPATH=/workspace/src \
  python -m aurora.aneug_release_730_split \
  --config /workspace/configs/aneug_release_730_protocol_v1.json \
  --source /data/processed_v5_9dd4180/assembled_registered_data_1k_v5.pth \
  --finalize-record /data/processed_v5_9dd4180/finalize_116626.ECE-util1.tsv \
  --schema-record /data/processed_v5_9dd4180/schema_116627.ECE-util1.json \
  --release-api-url "https://huggingface.co/api/datasets/whding123/AneuG-Flow/revision/9dd418083899deddd93a67f9a6fca7a14304fa36" \
  --split-key "/private/key/$split_key_name" \
  --public-result /output/public_split_result.json \
  --private-manifest /output/private_split_manifest.json
printf 'stage=split_complete\n'
