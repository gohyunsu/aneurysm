#!/bin/bash
#PBS -N aur730_current_t0
#PBS -l select=1:ncpus=4:mem=64gb:ngpus=1:Qlist=a6000
#PBS -l walltime=24:00:00
#PBS -j oe

set -euo pipefail
umask 077

: "${PBS_JOBID:?current locked test is PBS-only}"
: "${AURORA_PUBLIC_ROOT:?set exact clean Quality-passed evaluator checkout}"
: "${AURORA_CURRENT_T0_ACTIVATION:?set fresh private current-T0 activation}"
: "${AURORA_CURRENT_CHECKPOINT_MANIFEST:?set exact ten-checkpoint manifest}"
: "${AURORA_CURRENT_CHECKPOINT_ROOT:?set staged ten-checkpoint evidence root}"
: "${AURORA_CURRENT_MULTI_SEED_RESULT:?set complete five-seed validation result}"
: "${AURORA_DATA_ROOT:?set private AneuG data root}"
: "${AURORA_PRIVATE_SPLIT_MANIFEST:?set exact private split manifest}"
: "${AURORA_PRIVATE_TRAIN_AUDIT:?set exact private train audit}"
: "${AURORA_OUTPUT_ROOT:?set append-only attempt output root}"
: "${AURORA_ACCESS_SESSION_ROOT:?set stable one-session marker root across exact retries}"
: "${AURORA_EXPECTED_EVALUATOR_COMMIT:?set Quality-passed evaluator commit}"
: "${AURORA_EXECUTION_SERVER:?set introai9 or junjinyong}"
: "${AURORA_CONTAINER:?set pinned Torch container}"
: "${AURORA_CONTAINER_SHA256:?set pinned container SHA-256}"

case "$AURORA_EXECUTION_SERVER" in
  introai9) expected_queue=coss_a6gpu ;;
  junjinyong) expected_queue=ssu_a6gpu ;;
  *) exit 64 ;;
esac
[ "${PBS_O_QUEUE:-}" = "$expected_queue" ]

actual_commit="$(git -C "$AURORA_PUBLIC_ROOT" rev-parse HEAD)"
[ "$actual_commit" = "$AURORA_EXPECTED_EVALUATOR_COMMIT" ]
[ -z "$(git -C "$AURORA_PUBLIC_ROOT" status --porcelain)" ]
[ "$(/usr/bin/sha256sum "$AURORA_CONTAINER" | /usr/bin/cut -d' ' -f1)" = "$AURORA_CONTAINER_SHA256" ]
[ "$(/usr/bin/sha256sum "$AURORA_PRIVATE_SPLIT_MANIFEST" | /usr/bin/cut -d' ' -f1)" = "4ff881055c45ee87c917fbfe1a7ed5102ef63b9426539aea647eea7b65e3077f" ]
[ "$(/usr/bin/sha256sum "$AURORA_PRIVATE_TRAIN_AUDIT" | /usr/bin/cut -d' ' -f1)" = "ce1dd6d2852e290fbe187ac062af155f522cd4b8a82c1580b5430d15ed519385" ]

run_id="$PBS_JOBID"
run_root="$AURORA_OUTPUT_ROOT/aneug_release_730_ghd_current_locked_test_v1/$run_id"
/bin/mkdir -p "$run_root" "$AURORA_ACCESS_SESSION_ROOT"
[ ! -e "$run_root/attempt.started" ]
/usr/bin/printf '%s\n' "$run_id" > "$run_root/attempt.started"
log="$run_root/attempt.log"
status="$run_root/attempt.status.json"
status_tmp="$run_root/attempt.status.json.tmp"
exec >>"$log" 2>&1
trap 'code=$?; trap - EXIT; /usr/bin/printf "{\"job_id\":\"%s\",\"exit_code\":%s,\"access_session_started\":%s,\"complete\":%s}\n" "$run_id" "$code" "$(test -f "$AURORA_ACCESS_SESSION_ROOT/locked_test_access_session.json" && printf true || printf false)" "$(test -f "$run_root/result.json" && printf true || printf false)" > "$status_tmp"; /bin/mv "$status_tmp" "$status"; exit "$code"' EXIT

activation_parent="$(/usr/bin/dirname "$AURORA_CURRENT_T0_ACTIVATION")"
activation_name="$(/usr/bin/basename "$AURORA_CURRENT_T0_ACTIVATION")"
manifest_parent="$(/usr/bin/dirname "$AURORA_CURRENT_CHECKPOINT_MANIFEST")"
manifest_name="$(/usr/bin/basename "$AURORA_CURRENT_CHECKPOINT_MANIFEST")"
multiseed_parent="$(/usr/bin/dirname "$AURORA_CURRENT_MULTI_SEED_RESULT")"
multiseed_name="$(/usr/bin/basename "$AURORA_CURRENT_MULTI_SEED_RESULT")"
split_parent="$(/usr/bin/dirname "$AURORA_PRIVATE_SPLIT_MANIFEST")"
split_name="$(/usr/bin/basename "$AURORA_PRIVATE_SPLIT_MANIFEST")"
audit_parent="$(/usr/bin/dirname "$AURORA_PRIVATE_TRAIN_AUDIT")"
audit_name="$(/usr/bin/basename "$AURORA_PRIVATE_TRAIN_AUDIT")"

/usr/bin/printf 'stage=current_T0_started job=%s evaluator=%s server=%s queue=%s\n' \
  "$run_id" "$actual_commit" "$AURORA_EXECUTION_SERVER" "$expected_queue"
/usr/bin/singularity exec --nv --cleanenv \
  --bind "$AURORA_PUBLIC_ROOT:/workspace:ro" \
  --bind "$AURORA_DATA_ROOT:/data:ro" \
  --bind "$activation_parent:/private/activation:ro" \
  --bind "$manifest_parent:/private/manifest:ro" \
  --bind "$AURORA_CURRENT_CHECKPOINT_ROOT:/private/checkpoints:ro" \
  --bind "$multiseed_parent:/private/multiseed:ro" \
  --bind "$split_parent:/private/split:ro" \
  --bind "$audit_parent:/private/audit:ro" \
  --bind "$AURORA_ACCESS_SESSION_ROOT:/private/access" \
  --bind "$run_root:/output" \
  "$AURORA_CONTAINER" \
  /usr/bin/env PYTHONDONTWRITEBYTECODE=1 OMP_NUM_THREADS=4 MKL_NUM_THREADS=4 PYTHONPATH=/workspace/src \
  python -m aurora.aneug_release_730_ghd_current_locked_test \
  --config /workspace/configs/aneug_release_730_ghd_current_locked_test_v1.json \
  --expected-evaluator-commit "$actual_commit" \
  --activation "/private/activation/$activation_name" \
  --checkpoint-manifest "/private/manifest/$manifest_name" \
  --checkpoint-root /private/checkpoints \
  --multiseed-validation-result "/private/multiseed/$multiseed_name" \
  --matched-training-config /workspace/configs/aneug_release_730_matched_training_v1.json \
  --transient /data/processed_v5_9dd4180/assembled_registered_data_1k_v5.pth \
  --steady /data/processed_v4_d2/assembled_registered_steady_data_1k_v4.pth.temporary \
  --public-split /workspace/results/aneug_release_730_split_r3_20260818.json \
  --private-split "/private/split/$split_name" \
  --train-audit-public /workspace/results/aneug_release_730_train_audit_r2_20260818.json \
  --train-audit-private "/private/audit/$audit_name" \
  --access-marker /private/access/locked_test_access_session.json \
  --result /output/result.json \
  --figure-selection /output/figure_selection.json \
  --figure-payload /output/figure_payload.pt
/usr/bin/printf 'stage=current_T0_complete\n'
