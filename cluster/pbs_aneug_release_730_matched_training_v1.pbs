#!/bin/bash
#PBS -N aurora_730_matched_train
#PBS -q coss_a6gpu
#PBS -l select=1:ncpus=4:mem=64gb:ngpus=1:Qlist=a6000
#PBS -l walltime=72:00:00
#PBS -j oe

set -euo pipefail

: "${AURORA_PROJECT_ROOT:?set exact clean public checkout}"
: "${AURORA_DATA_ROOT:?set private AneuG data root}"
: "${AURORA_OUTPUT_ROOT:?set private output root}"
: "${AURORA_EXPECTED_COMMIT:?set Quality-passed exact commit}"
: "${AURORA_MATCHED_ACTIVATION:?set fresh one-cell private activation}"
: "${AURORA_MATCHED_MODEL_ROLE:?set selected_control or selected_proposal}"
: "${AURORA_MATCHED_INFORMATION_MODE:?set transient_only, transient_mean or eligible_steady}"
: "${AURORA_DEVELOPMENT_EVIDENCE_BUNDLE:?set exact terminal development bundle}"
: "${AURORA_SELECTED_MODEL_RECORD:?set exact validation-only selection record}"
: "${AURORA_STEADY_SCALE_RESULT:?set exact descriptive steady-scale result}"
: "${AURORA_PRIVATE_SPLIT_MANIFEST:?set exact private R3 split manifest}"
: "${AURORA_PRIVATE_TRAIN_AUDIT:?set exact private train-audit statistics}"
: "${AURORA_PRIVATE_OVERLAP_RESULT:?set exact leakage-audited steady scope}"
: "${AURORA_CONTAINER:?set pinned Torch container}"
: "${AURORA_CONTAINER_SHA256:?set pinned container SHA-256}"

case "$AURORA_MATCHED_MODEL_ROLE" in
  selected_control)
    [ -z "${AURORA_RESPONSE_BASIS:-}" ]
    ;;
  selected_proposal)
    [ -r "${AURORA_RESPONSE_BASIS:?set selected train-only response basis}" ]
    ;;
  *) exit 64 ;;
esac
case "$AURORA_MATCHED_INFORMATION_MODE" in
  transient_only|transient_mean|eligible_steady) ;;
  *) exit 64 ;;
esac

actual_commit="$(git -C "$AURORA_PROJECT_ROOT" rev-parse HEAD)"
[ "$actual_commit" = "$AURORA_EXPECTED_COMMIT" ]
[ -z "$(git -C "$AURORA_PROJECT_ROOT" status --porcelain)" ]
for evidence in \
  "$AURORA_MATCHED_ACTIVATION" \
  "$AURORA_DEVELOPMENT_EVIDENCE_BUNDLE" \
  "$AURORA_SELECTED_MODEL_RECORD" \
  "$AURORA_STEADY_SCALE_RESULT" \
  "$AURORA_PRIVATE_SPLIT_MANIFEST" \
  "$AURORA_PRIVATE_TRAIN_AUDIT" \
  "$AURORA_PRIVATE_OVERLAP_RESULT"
do
  [ -r "$evidence" ]
done
[ "$(/usr/bin/sha256sum "$AURORA_PRIVATE_SPLIT_MANIFEST" | /usr/bin/cut -d' ' -f1)" = "4ff881055c45ee87c917fbfe1a7ed5102ef63b9426539aea647eea7b65e3077f" ]
[ "$(/usr/bin/sha256sum "$AURORA_PRIVATE_TRAIN_AUDIT" | /usr/bin/cut -d' ' -f1)" = "ce1dd6d2852e290fbe187ac062af155f522cd4b8a82c1580b5430d15ed519385" ]
[ "$(/usr/bin/sha256sum "$AURORA_PRIVATE_OVERLAP_RESULT" | /usr/bin/cut -d' ' -f1)" = "52219b9a7161f0932a4ed80020a339510474431b67e168741426c2a12e5092ef" ]
[ "$(/usr/bin/sha256sum "$AURORA_CONTAINER" | /usr/bin/cut -d' ' -f1)" = "$AURORA_CONTAINER_SHA256" ]

run_id="${PBS_JOBID:-manual_$(date -u +%Y%m%dT%H%M%SZ)}"
run_root="$AURORA_OUTPUT_ROOT/aneug_release_730_matched_training_v1/$run_id"
mkdir -p "$run_root"
[ ! -e "$run_root/attempt.started" ]
printf '%s\n' "$run_id" > "$run_root/attempt.started"
log="$run_root/attempt.log"
status="$run_root/attempt.status.json"
status_tmp="$run_root/attempt.status.json.tmp"
exec >>"$log" 2>&1
trap 'code=$?; trap - EXIT; printf "{\"job_id\":\"%s\",\"exit_code\":%s,\"complete\":%s}\n" "$run_id" "$code" "$(test -f "$run_root/result.json" && printf true || printf false)" > "$status_tmp"; /bin/mv "$status_tmp" "$status"; exit "$code"' EXIT

activation_parent="$(/usr/bin/dirname "$AURORA_MATCHED_ACTIVATION")"
activation_name="$(/usr/bin/basename "$AURORA_MATCHED_ACTIVATION")"
bundle_parent="$(/usr/bin/dirname "$AURORA_DEVELOPMENT_EVIDENCE_BUNDLE")"
bundle_name="$(/usr/bin/basename "$AURORA_DEVELOPMENT_EVIDENCE_BUNDLE")"
selection_parent="$(/usr/bin/dirname "$AURORA_SELECTED_MODEL_RECORD")"
selection_name="$(/usr/bin/basename "$AURORA_SELECTED_MODEL_RECORD")"
scale_parent="$(/usr/bin/dirname "$AURORA_STEADY_SCALE_RESULT")"
scale_name="$(/usr/bin/basename "$AURORA_STEADY_SCALE_RESULT")"
split_parent="$(/usr/bin/dirname "$AURORA_PRIVATE_SPLIT_MANIFEST")"
split_name="$(/usr/bin/basename "$AURORA_PRIVATE_SPLIT_MANIFEST")"
audit_parent="$(/usr/bin/dirname "$AURORA_PRIVATE_TRAIN_AUDIT")"
audit_name="$(/usr/bin/basename "$AURORA_PRIVATE_TRAIN_AUDIT")"
overlap_parent="$(/usr/bin/dirname "$AURORA_PRIVATE_OVERLAP_RESULT")"
overlap_name="$(/usr/bin/basename "$AURORA_PRIVATE_OVERLAP_RESULT")"

basis_bind_args=()
basis_cli_args=()
if [ "$AURORA_MATCHED_MODEL_ROLE" = "selected_proposal" ]; then
  basis_parent="$(/usr/bin/dirname "$AURORA_RESPONSE_BASIS")"
  basis_name="$(/usr/bin/basename "$AURORA_RESPONSE_BASIS")"
  basis_bind_args=(--bind "$basis_parent:/private/basis:ro")
  basis_cli_args=(--response-basis "/private/basis/$basis_name")
fi

resume_bind_args=()
resume_cli_args=()
if [ -n "${AURORA_MATCHED_RESUME_CHECKPOINT:-}" ]; then
  [ -r "$AURORA_MATCHED_RESUME_CHECKPOINT" ]
  [ -r "${AURORA_MATCHED_PRIOR_ATTEMPT_TERMINAL_RECORD:?set prior failed/interrupted attempt terminal record}" ]
  resume_parent="$(/usr/bin/dirname "$AURORA_MATCHED_RESUME_CHECKPOINT")"
  resume_name="$(/usr/bin/basename "$AURORA_MATCHED_RESUME_CHECKPOINT")"
  prior_parent="$(/usr/bin/dirname "$AURORA_MATCHED_PRIOR_ATTEMPT_TERMINAL_RECORD")"
  prior_name="$(/usr/bin/basename "$AURORA_MATCHED_PRIOR_ATTEMPT_TERMINAL_RECORD")"
  resume_bind_args=(
    --bind "$resume_parent:/private/resume:ro"
    --bind "$prior_parent:/private/prior_terminal:ro"
  )
  resume_cli_args=(
    --resume-checkpoint "/private/resume/$resume_name"
    --prior-attempt-terminal-record "/private/prior_terminal/$prior_name"
  )
else
  [ -z "${AURORA_MATCHED_PRIOR_ATTEMPT_TERMINAL_RECORD:-}" ]
fi

printf 'stage=release730_matched_training_started job=%s commit=%s role=%s information=%s\n' \
  "$run_id" "$actual_commit" "$AURORA_MATCHED_MODEL_ROLE" \
  "$AURORA_MATCHED_INFORMATION_MODE"
/usr/bin/singularity exec --nv --cleanenv \
  --bind "$AURORA_PROJECT_ROOT:/workspace:ro" \
  --bind "$AURORA_DATA_ROOT:/data:ro" \
  --bind "$activation_parent:/private/activation:ro" \
  --bind "$bundle_parent:/private/bundle:ro" \
  --bind "$selection_parent:/private/selection:ro" \
  --bind "$scale_parent:/private/scale:ro" \
  --bind "$split_parent:/private/split:ro" \
  --bind "$audit_parent:/private/audit:ro" \
  --bind "$overlap_parent:/private/overlap:ro" \
  "${basis_bind_args[@]}" \
  "${resume_bind_args[@]}" \
  --bind "$run_root:/output" \
  "$AURORA_CONTAINER" \
  /usr/bin/env PYTHONDONTWRITEBYTECODE=1 OMP_NUM_THREADS=4 MKL_NUM_THREADS=4 CUBLAS_WORKSPACE_CONFIG=:4096:8 PYTHONPATH=/workspace/src \
  python -m aurora.aneug_release_730_matched_training \
  --config /workspace/configs/aneug_release_730_matched_training_v1.json \
  --activation "/private/activation/$activation_name" \
  --expected-commit "$actual_commit" \
  --model-role "$AURORA_MATCHED_MODEL_ROLE" \
  --information-mode "$AURORA_MATCHED_INFORMATION_MODE" \
  --development-evidence-bundle "/private/bundle/$bundle_name" \
  --selection-record "/private/selection/$selection_name" \
  --steady-scale-result "/private/scale/$scale_name" \
  --transient /data/processed_v5_9dd4180/assembled_registered_data_1k_v5.pth \
  --steady /data/processed_v4_d2/assembled_registered_steady_data_1k_v4.pth.temporary \
  --public-split /workspace/results/aneug_release_730_split_r3_20260818.json \
  --private-split "/private/split/$split_name" \
  --train-audit-public /workspace/results/aneug_release_730_train_audit_r2_20260818.json \
  --train-audit-private "/private/audit/$audit_name" \
  --public-overlap /workspace/results/aneug_release_730_steady_overlap_audit_r2_20260818.json \
  --private-overlap "/private/overlap/$overlap_name" \
  --steady-scope-config /workspace/configs/aneug_release_730_steady_training_scope_v1.json \
  --steady-exposure-config /workspace/configs/aneug_release_730_steady_exposure_schedule_v1.json \
  --response-local-config /workspace/configs/aneug_release_730_response_local_candidate_v1.json \
  --ghd-gps-config /workspace/configs/aneug_release_730_ghd_gps_baseline_v1.json \
  --transolver-config /workspace/configs/aneug_release_730_transolver_baseline_v1.json \
  --result /output/result.json \
  --checkpoint-directory /output/checkpoints \
  "${basis_cli_args[@]}" \
  "${resume_cli_args[@]}"
printf 'stage=release730_matched_training_complete\n'
