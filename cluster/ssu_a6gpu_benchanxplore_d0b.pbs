#!/usr/bin/env bash
#PBS -N aurora_bench_d0b
#PBS -q ssu_a6gpu
#PBS -l select=1:ncpus=4:mem=32gb:ngpus=1:Qlist=a6000
#PBS -l walltime=01:30:00
#PBS -j oe

set -euo pipefail

: "${AURORA_PROJECT_ROOT:?set AURORA_PROJECT_ROOT}"
: "${AURORA_BENCH_DATA_ROOT:?set AURORA_BENCH_DATA_ROOT}"
: "${AURORA_OUTPUT_ROOT:?set AURORA_OUTPUT_ROOT}"
: "${AURORA_SIF:?set AURORA_SIF}"
: "${AURORA_DEPS_ROOT:?set AURORA_DEPS_ROOT}"
: "${AURORA_GIT_COMMIT:?set AURORA_GIT_COMMIT}"

mkdir -p "$AURORA_OUTPUT_ROOT"
cd "$PBS_O_WORKDIR"

hostname
nvidia-smi

singularity exec --nv --cleanenv \
  --bind "$AURORA_PROJECT_ROOT:/workspace:ro" \
  --bind "$AURORA_BENCH_DATA_ROOT:/data:ro" \
  --bind "$AURORA_OUTPUT_ROOT:/output" \
  --bind "$AURORA_DEPS_ROOT:/deps:ro" \
  "$AURORA_SIF" \
  env PYTHONPATH="/workspace/src:/deps" AURORA_GIT_COMMIT="$AURORA_GIT_COMMIT" \
  python /workspace/experiments/run_benchanxplore_d0b.py \
    --data-root /data/coarse_dataset \
    --config /workspace/configs/benchanxplore_d0b.json \
    --output /output \
    --git-commit "$AURORA_GIT_COMMIT" \
    --require-cuda
