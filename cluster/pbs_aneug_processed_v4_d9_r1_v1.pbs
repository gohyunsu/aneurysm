#!/bin/bash
#PBS -N aurora_aneug_d9_r1
#PBS -q coss_agpu
#PBS -l select=1:ncpus=4:mem=64gb:ngpus=1
#PBS -l walltime=12:00:00

record_root="${PBS_O_WORKDIR:-.}"
/bin/mkdir -p "$record_root" || exit 70
if [ -e "$record_root/attempt.started" ]; then
  printf '%s\n' "D9 R1 attempt already exists; rerun or repair is forbidden" >&2
  exit 90
fi
printf '%s\n' "${PBS_JOBID:-missing}" > "$record_root/attempt.started" || exit 71
exec >>"$record_root/attempt.log" 2>&1

attempt_status="$record_root/attempt.status.json"
status_tmp="$record_root/attempt.status.json.tmp"
training_complete_json=false

set -euo pipefail
trap 'code=$?; trap - EXIT; printf "{\"exit_code\":%s,\"complete\":%s,\"training_complete\":%s,\"stage_closed\":true}\n" "$code" "$(test -e "$record_root/attempt.complete" && printf true || printf false)" "$training_complete_json" > "$status_tmp"; /bin/mv -f "$status_tmp" "$attempt_status"; exit "$code"' EXIT

: "${AURORA_PROJECT_ROOT:?set exact clean public checkout}"
: "${AURORA_PYTHON:?set approved Python executable}"
: "${AURORA_EXPECTED_COMMIT:?set Quality-passed exact commit}"
: "${AURORA_D9_ACTIVATION:?set private D9 activation manifest}"
: "${AURORA_D9_CACHE:?set completed private D9 cache path}"
: "${AURORA_VARIANT:?set direct_cycle or moment_pod}"
case "$AURORA_VARIANT" in
  direct_cycle|moment_pod) ;;
  *) printf '%s\n' "invalid registered D9 variant" >&2; exit 72 ;;
esac

actual_commit="$(/usr/bin/git -C "$AURORA_PROJECT_ROOT" rev-parse HEAD)"
[ "$actual_commit" = "$AURORA_EXPECTED_COMMIT" ]
[ -z "$(/usr/bin/git -C "$AURORA_PROJECT_ROOT" status --porcelain)" ]
[ -x "$AURORA_PYTHON" ]
[ -f "$AURORA_D9_CACHE/cache_manifest.json" ]

config="$AURORA_PROJECT_ROOT/configs/aneug_processed_v4_d9_mesh_canonicalized_pilot_v1.json"
printf 'stage=R1_%s_started job=%s commit=%s\n' "$AURORA_VARIANT" "${PBS_JOBID:-missing}" "$actual_commit"
export OMP_NUM_THREADS=4
export MKL_NUM_THREADS=4
PYTHONPATH="$AURORA_PROJECT_ROOT/src" "$AURORA_PYTHON" \
  -m aurora.aneug_processed_v4_d9 \
  --config "$config" \
  --mode train \
  --activation "$AURORA_D9_ACTIVATION" \
  --expected-commit "$AURORA_EXPECTED_COMMIT" \
  --cache "$AURORA_D9_CACHE" \
  --variant "$AURORA_VARIANT" \
  --result "$record_root/${AURORA_VARIANT}_result.json" \
  --checkpoint "$record_root/${AURORA_VARIANT}_best.pt"

training_complete_json=true
printf '%s\n' complete > "$record_root/attempt.complete"
printf 'stage=R1_%s_complete\n' "$AURORA_VARIANT"
