#!/usr/bin/env bash
#PBS -N aurora_exact_g1
#PBS -q ssu_a6gpu
#PBS -l select=1:ncpus=2:mem=16gb:ngpus=1:Qlist=a6000
#PBS -l walltime=01:00:00
#PBS -j oe

set -euo pipefail

: "${AURORA_PROJECT_ROOT:?set AURORA_PROJECT_ROOT}"
: "${AURORA_OUTPUT_ROOT:?set AURORA_OUTPUT_ROOT}"
: "${AURORA_SIF:?set AURORA_SIF}"
: "${AURORA_GIT_COMMIT:?set AURORA_GIT_COMMIT}"

mkdir -p "$AURORA_OUTPUT_ROOT"
cd "$PBS_O_WORKDIR"

hostname
nvidia-smi

singularity exec --nv --cleanenv \
  --bind "$AURORA_PROJECT_ROOT:/workspace:ro" \
  --bind "$AURORA_OUTPUT_ROOT:/output" \
  "$AURORA_SIF" \
  env PYTHONPATH="/workspace/src" AURORA_GIT_COMMIT="$AURORA_GIT_COMMIT" \
  python /workspace/experiments/run_controlled_pde_g1.py \
    --config /workspace/configs/controlled_pde_g1.json \
    --output /output \
    --git-commit "$AURORA_GIT_COMMIT" \
    --require-cuda
