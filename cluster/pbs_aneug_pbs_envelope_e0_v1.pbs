#!/bin/bash
#PBS -N aurora_aneug_e0v1
#PBS -q coss_agpu
#PBS -l select=1:ncpus=1:mem=2gb:ngpus=0
#PBS -l walltime=00:05:00

record_root="${PBS_O_WORKDIR:-.}"
/bin/mkdir -p "$record_root" || exit 70
if [ -e "$record_root/attempt.started" ]; then
  printf '%s\n' "E0 attempt already exists; rerun or repair is forbidden" >&2
  exit 90
fi
printf '%s\n' "${PBS_JOBID:-missing}" > "$record_root/attempt.started" || exit 71
exec >>"$record_root/attempt.log" 2>&1

set -euo pipefail
: "${AURORA_PROJECT_ROOT:?set exact clean public checkout}"
: "${AURORA_PYTHON:?set approved Python executable}"
: "${AURORA_EXPECTED_COMMIT:?set Quality-passed exact commit}"

attempt_status="$record_root/attempt.status.json"
status_tmp="$record_root/attempt.status.json.tmp"
public_result="$record_root/public_envelope_result.json"
envelope_pass_json=null
trap 'code=$?; trap - EXIT; printf "{\"exit_code\":%s,\"complete\":%s,\"envelope_pass\":%s,\"e0_closed\":true,\"scientific_verdict\":null}\n" "$code" "$(test -e "$record_root/attempt.complete" && printf true || printf false)" "$envelope_pass_json" > "$status_tmp"; /bin/mv -f "$status_tmp" "$attempt_status"; exit "$code"' EXIT

[ -x "$AURORA_PYTHON" ]
printf 'stage=wrapper_started job=%s\n' "${PBS_JOBID:-missing}"
PYTHONPATH="$AURORA_PROJECT_ROOT/src" "$AURORA_PYTHON" \
  -m aurora.aneug_pbs_envelope_e0 \
  --config "$AURORA_PROJECT_ROOT/configs/aneug_pbs_envelope_e0_v1.json" \
  --project-root "$AURORA_PROJECT_ROOT" \
  --expected-commit "$AURORA_EXPECTED_COMMIT" \
  --output "$public_result"

envelope_pass_json="$("$AURORA_PYTHON" -c 'import json,sys; print(str(json.load(open(sys.argv[1], encoding="utf-8"))["envelope_pass"]).lower())' "$public_result")"
printf '%s\n' complete > "$record_root/attempt.complete"
printf 'stage=envelope_complete pass=%s\n' "$envelope_pass_json"
